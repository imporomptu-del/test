{
  "schema_version": 1,
  "input": {"source": "video", "path": "unused_motion_only_source_supplied_by_cli"},
  "motion": {
    "backend": "PVA",
    "feature_intensity_mapping": "raw_robust_u16_v1",
    "optical_flow_backend": "CUDA",
    "feature_image_scale": 0.5,
    "max_features": 1000,
    "grid_rows": 6,
    "grid_cols": 8,
    "feature_border_px": 16.0,
    "saturation_fraction": 0.995,
    "saturated_neighborhood_radius_px": 2,
    "exclusion_regions_xyxy": [],
    "harris_strength": 0.5,
    "harris_sensitivity": 0.0625,
    "harris_gradient_size": 3,
    "harris_block_size": 3,
    "harris_min_nms_distance": 8,
    "pyramid_levels": 4,
    "pyramid_scale": 0.5,
    "pyramid_backend": "auto",
    "window_size": 11,
    "max_iterations": 6,
    "forward_backward_check": true,
    "max_forward_backward_error_px": 3.0,
    "max_displacement_px": 120.0,
    "minimum_accepted_features": 30,
    "minimum_grid_coverage": 0.2
  },
  "global_motion": {
    "model": "translation",
    "ransac_iterations": 500,
    "ransac_reprojection_px": 1.0,
    "random_seed": 75,
    "minimum_correspondences": 30,
    "minimum_inliers": 30,
    "minimum_inlier_ratio": 0.6,
    "grid_rows": 6,
    "grid_cols": 8,
    "minimum_inlier_grid_coverage": 0.2,
    "maximum_median_reprojection_px": 0.35,
    "maximum_p90_reprojection_px": 0.75,
    "maximum_reprojection_px": 2.0,
    "maximum_translation_px": 120.0,
    "maximum_rotation_deg": 2.0,
    "minimum_scale": 0.98,
    "maximum_scale": 1.02,
    "minimum_noncollinearity_ratio": 0.01,
    "minimum_sample_separation_px": 32.0,
    "failure_policy": "reset_reference",
    "maximum_reuse_pairs": 1,
    "coverage_policy": "translation_consensus",
    "sparse_minimum_cells": 4,
    "sparse_minimum_points_per_cell": 4,
    "sparse_minimum_span_fraction": 0.25
  },
  "stabilization": {
    "backend": "opencv_cpu",
    "interpolation": "cubic",
    "border_value": 0.0,
    "valid_mask_erosion_px": 2,
    "integration_window_frames": 8,
    "alignment_sample_stride": 8,
    "skip_exact_identity_warp": true
  }
}
